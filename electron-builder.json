{
  "appId": "org.orb.browser",
  "productName": "Orb",
  "protocols": [
    {
      "name": "Web URL",
      "schemes": ["http", "https"]
    }
  ],
  "afterSign": "scripts/notarize.cjs",
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64"] },
      { "target": "zip", "arch": ["arm64"] }
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "extendInfo": {
      "NSCameraUsageDescription": "Orb uses the camera only when you allow a site to use it, for example on a video call.",
      "NSMicrophoneUsageDescription": "Orb uses the microphone only when you allow a site to use it, for example on a call or voice recording.",
      "NSLocationUsageDescription": "Orb shares your location only when you allow a site to use it.",
      "NSAudioCaptureUsageDescription": "Orb captures system audio only when you allow a site to share audio while screen sharing.",
      "NSDocumentsFolderUsageDescription": "Orb needs access to the Documents folder only when you download a file there.",
      "NSDownloadsFolderUsageDescription": "Orb saves downloads to your Downloads folder."
    }
  },
  "dmg": {
    "icon": "build/icon.icns",
    "background": "build/dmg-background.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "window": {
      "width": 660,
      "height": 420
    },
    "contents": [
      { "x": 170, "y": 250, "type": "file", "name": "Orb.app" },
      { "x": 490, "y": 250, "type": "link", "name": "Applications", "path": "/Applications" }
    ]
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "releaseInfo": {
    "releaseNotesFile": "docs/release-notes.md"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "flashrod",
      "repo": "orb",
      "releaseType": "release"
    }
  ]
}
