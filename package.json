{
  "name": "orb",
  "productName": "Orb",
  "version": "0.1.0",
  "description": "An Arc-inspired browser built with Electron and React",
  "main": "packages/main/index.js",
  "author": "flashrod",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite --config vite.config.ts\" \"wait-on http://localhost:5173 && electron packages/main/index.js\"",
    "build": "tsc && vite build",
    "dist": "electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron": "^30.0.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron-builder": "^25.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
