{
  "name": "orb",
  "productName": "Orb",
  "version": "0.1.0",
  "description": "An Arc-inspired browser built with Electron and React",
  "main": "dist/main.js",
  "author": "flashrod",
  "license": "MIT",
  "scripts": {
    "dev:main": "concurrently \"esbuild packages/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.js --external:electron --external:sql.js --watch\" \"esbuild packages/preload/webview.ts --bundle --platform=node --format=cjs --outfile=dist/preload/webview.js --external:electron --watch\" \"esbuild packages/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload/index.js --external:electron --watch\"",
    "dev": "concurrently \"vite --config vite.config.mts\" \"npm run dev:main\" \"wait-on http://localhost:5173 && ELECTRON_DEV=true electron dist/main.js\"",
    "dev:native": "ORB_NATIVE_TABS=1 npm run dev",
    "build": "esbuild packages/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.js --external:electron --external:sql.js && esbuild packages/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload/index.js --external:electron && esbuild packages/preload/webview.ts --bundle --platform=node --format=cjs --outfile=dist/preload/webview.js --external:electron && vite build",
    "predist": "npm run build",
    "dist": "electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "benchmark": "electron scripts/benchmark/run.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^2.6.1",
    "tldts": "^6.1.86",
    "ws": "^8.22.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron": "^1.6.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
